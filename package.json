{
  "name": "agent-controller",
  "productName": "Aurelium",
  "version": "0.1.2",
  "description": "Sessões de Claude Code e Codex em uma janela só, com avisos de estado e visão das mudanças.",
  "author": {
    "name": "Henrique",
    "email": "HenriqueAurelio@users.noreply.github.com"
  },
  "homepage": "https://github.com/HenriqueAurelio/agent-controller",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:core": "vitest run tests/core",
    "test:core:docker": "docker build --target core -t agent-controller-core . && docker run --rm agent-controller-core",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:smoke": "vitest run --config tests/smoke/vitest.config.ts",
    "test:smoke:app": "playwright test --config tests/smoke/playwright.config.ts",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "measure": "node tools/memory/measure.mjs",
    "measure:load": "node tools/perf/load.mjs"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "monaco-editor": "0.57.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
